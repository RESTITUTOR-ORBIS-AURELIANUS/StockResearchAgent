TUSHARE_PRIMARY_BASE_URL=http://datahubco.com/app-api/openapi/v1/tushare
TUSHARE_PRIMARY_API_KEY=replace-with-primary-api-key
TUSHARE_BACKUP_BASE_URL=https://quantdata888.duckdns.org
TUSHARE_BACKUP_TOKEN=replace-with-backup-token
TUSHARE_REQUEST_TIMEOUT_SECONDS=30

# AKShare 通过公开网页接口提供新闻和公告，不需要 Token。它是同步库，项目用专用线程池隔离。
AKSHARE_REQUEST_TIMEOUT_SECONDS=30
AKSHARE_MAX_WORKERS=2

# 阿里云百炼 Model Studio（OpenAI-compatible）；不要与行情服务的 Token 混用。
LLM_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-bailian-api-key
LLM_MODEL=qwen3.8-max
LLM_REQUEST_TIMEOUT_SECONDS=1200
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
# qwen3.8-max 支持原生严格 JSON Schema，直接匹配项目的 Pydantic 输出模型。
LLM_STRUCTURED_OUTPUT_METHOD=json_schema
# 严格模式负责约束 JSON 形状；本地 Pydantic 仍负责跨字段业务规则。
LLM_STRUCTURED_OUTPUT_STRICT=true
# 本地校验失败后，把具体字段错误交还给模型纠正一次。
LLM_STRUCTURED_OUTPUT_REPAIR_ATTEMPTS=1
# 每次结构化调用的状态、token、finish_reason 和失败响应写入该 JSONL；目录不会进 Git。
LLM_STRUCTURED_OUTPUT_DIAGNOSTICS_PATH=.artifacts/llm-structured-output.jsonl
LLM_STRUCTURED_OUTPUT_RAW_MAX_CHARACTERS=20000
